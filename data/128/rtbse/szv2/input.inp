&GLOBAL
  PROJECT_NAME rec_4
  RUN_TYPE RT_PROPAGATION
  PRINT_LEVEL MEDIUM
  &TIMINGS
    THRESHOLD 0.0
  &END TIMINGS
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 20000
    TEMPERATURE [K] 0.0
    TIMESTEP [fs] 0.01
  &END MD
&END MOTION

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states
    BASIS_SET_FILE_NAME BASIS_GTH_MOLOPT_AUG_for_excited_states_RI
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-15
      METHOD GPW
    &END QS
    &REAL_TIME_PROPAGATION
      APPLY_DELTA_PULSE
      DELTA_PULSE_DIRECTION 0 1 0
      DELTA_PULSE_SCALE 1.0E-03
      INITIAL_WFN SCF_WFN
      &PRINT
        &RESTART
          &EACH
            MD 50
          &END EACH
        &END RESTART
      &END PRINT
      &RTBSE
        LRRTBSE T
        TDA T
        ENFORCE_MAX_DT T
        ENERGY_CUTOFF_OCC 10
        ENERGY_CUTOFF_EMPTY 10
        CUTOFF_RADIUS_W0 50
      &END RTBSE
      &FT
        ! gamma = hbar/DAMPING = 0.6582/13.1642 = 0.0500 eV, matching BSE
        DAMPING [fs] 13.1642
        &PADE
          E_MIN [eV] 0.0
          E_MAX [eV] 20.0
          E_STEP [eV] 0.01
        &END PADE
      &END FT
    &END REAL_TIME_PROPAGATION
    &SCF
      SCF_GUESS RESTART
      EPS_SCF 1.0E-7
      MAX_SCF 300
      CHOLESKY OFF
      ADDED_MOS 100
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 4
      &END MIXING
      &PRINT
        &RESTART
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER MULTIPOLE
      &MULTIPOLE
           ANALYTICAL_GTERM T
      &END MULTIPOLE
    &END POISSON
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        CUTOFF_RADIUS_RI             7.0
        EPS_FILTER                   1.0E-10
        &RI_RS
          GRID_SELECT                1
          CUTOFF_RADIUS_RL_AO        7
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 200
            N_POINT_PERCENTAGE 20
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC 19.19 556.55 11.55
      PERIODIC NONE
    &END CELL
    &KIND H
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_005_s_p_d_f_g_h_i_2_1_0_0_0_0_0_error_6.8e-04
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      BASIS_SET RI_AUX RI_aug-SZV-MOLOPT-GTH-tier-2_N_RI_030_s_p_d_f_g_h_i_4_3_2_1_0_0_0_error_3.2e-05
      POTENTIAL GTH-PBE-q4
    &END KIND
    &TOPOLOGY
        COORD_FILE_NAME struc.xyz
        COORD_FILE_FORMAT xyz
        &CENTER_COORDINATES
        &END
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
